# Dev: as chamadas /api/landxml, /api/sondagem, /api/auth e /oauth são
# resolvidas pelo proxy do Vite (vite.config.ts) → mantaapi/hub. Por isso
# deixamos os VITE_*_API_URL vazios (o cliente usa os fallbacks /api/...).

# OAuth SSO "Entrar com Manta Hub"
VITE_OAUTH_ISSUER=https://hub.mantaassociados.com
VITE_OAUTH_CLIENT_ID=dashboard-terraplenagem
