# Prod: o netlify.toml faz o proxy same-origin (/api/landxml, /api/sondagem,
# /api/auth, /oauth), então mantemos os fallbacks e não expomos URLs absolutas.

# OAuth SSO "Entrar com Manta Hub"
VITE_OAUTH_ISSUER=https://hub.mantaassociados.com
VITE_OAUTH_CLIENT_ID=dashboard-terraplenagem

# Chat do assistente (AskCAD): cross-origin DIRETO — o proxy do Netlify
# bufferiza/expira SSE (ver netlify.toml). CORS liberado no backend askcad.
VITE_ASKCAD_API_URL=https://mantaapi.mantaassociados.com/askcad/api
